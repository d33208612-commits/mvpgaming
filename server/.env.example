# ============================================================
# MVP Gaming backend configuration — copy to ".env" and fill in.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# Telegram bot token from @BotFather (REQUIRED for real codes).
# Get/regenerate it via @BotFather -> /mybots -> API Token.
BOT_TOKEN=123456789:PASTE-YOUR-TOKEN-FROM-BOTFATHER

# Bot @username (optional — auto-detected from the token on startup).
BOT_USERNAME=MVPGamingBot

# HTTP port for the API + static app.
PORT=8787

# Verification code lifetime, in minutes.
CODE_TTL_MIN=10

# Serve the frontend from this server too (true/false).
SERVE_STATIC=true

# Optional: Telegram chat id that receives new "club registration" requests.
# ADMIN_CHAT_ID=123456789
