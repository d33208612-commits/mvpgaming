# Telegram bot token from @BotFather — REQUIRED in production.
# The Mini App validates initData (HMAC-SHA256) using this token.
BOT_TOKEN=

# HTTP port
PORT=3001

# Allow dev login without Telegram (browser testing). Set to 0 in production.
ALLOW_DEV_AUTH=1

# Max age of initData (seconds). 0 disables the freshness check.
INITDATA_MAX_AGE=86400

# Path to the SQLite database file
DB_PATH=./data/app.db

# Public HTTPS URL of the deployed app (e.g. https://your-app.onrender.com).
# Used to auto-configure the bot menu button and /start button.
# On Render/Railway this is detected automatically — leave empty there.
PUBLIC_URL=

# Run the built-in Telegram bot (menu button + /start) with the server.
RUN_BOT=1

# Admin panel password (required for the /start → "Админ-панель" flow).
ADMIN_PASSWORD=

# Telegram username (without @) opened by the "Поддержка" button.
SUPPORT_USERNAME=developer_kd

# Max vacancies one employer can publish per 7 days.
VACANCY_WEEKLY_LIMIT=5
