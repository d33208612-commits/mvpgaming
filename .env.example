# Copy to .env and fill in to enable real Claude-powered generation.
# Without a key, the app still works using the built-in local generator.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-4-8).
# For lower cost/latency you can use claude-sonnet-4-6 or claude-haiku-4-5.
# KARTIX_MODEL=claude-opus-4-8

# Optional: server port (default 8787)
# PORT=8787
